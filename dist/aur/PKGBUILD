# Maintainer: imjustprism <snawalt420@proton.me>
pkgname=holdon-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Wait for anything. Know why if it doesn't."
arch=('x86_64' 'aarch64')
url="https://github.com/imjustprism/holdon"
license=('MIT' 'Apache')
provides=('holdon')
conflicts=('holdon')
source_x86_64=("https://github.com/imjustprism/holdon/releases/download/v${pkgver}/holdon-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/imjustprism/holdon/releases/download/v${pkgver}/holdon-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('6a340f26434d0d3c2a16ffed35a5b6754755eb7a5b37929cb6dffead1a2c59b0')
sha256sums_aarch64=('ef06f0efec6b17971f1a5a632958425d4d0896c4d50b62d91d0b06762f6699ac')

package() {
  install -Dm755 "${srcdir}/holdon-${CARCH}-unknown-linux-musl/holdon" "${pkgdir}/usr/bin/holdon"
  install -Dm644 "${srcdir}/holdon-${CARCH}-unknown-linux-musl/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 "${srcdir}/holdon-${CARCH}-unknown-linux-musl/LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
  install -Dm644 "${srcdir}/holdon-${CARCH}-unknown-linux-musl/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  install -d "${pkgdir}/usr/share/bash-completion/completions"
  install -d "${pkgdir}/usr/share/zsh/site-functions"
  install -d "${pkgdir}/usr/share/fish/vendor_completions.d"
  install -d "${pkgdir}/usr/share/man/man1"

  "${pkgdir}/usr/bin/holdon" --generate-completion bash > "${pkgdir}/usr/share/bash-completion/completions/holdon" || true
  "${pkgdir}/usr/bin/holdon" --generate-completion zsh  > "${pkgdir}/usr/share/zsh/site-functions/_holdon"       || true
  "${pkgdir}/usr/bin/holdon" --generate-completion fish > "${pkgdir}/usr/share/fish/vendor_completions.d/holdon.fish" || true
  "${pkgdir}/usr/bin/holdon" --generate-manpage         > "${pkgdir}/usr/share/man/man1/holdon.1"               || true
}
